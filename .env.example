# ---- GCP (Phase 8) ----
GCP_PROJECT=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCS_BUCKET=
CLUSTER_NAME=etherlens
START_DATE=2025-01-01
END_DATE=2025-02-01
MAX_SCAN_GB=300
# Cluster shape (defaults = spec free-trial shape). Stage C real data needs more memory,
# e.g. MASTER_TYPE=e2-standard-4 WORKER_TYPE=e2-highmem-4 NUM_WORKERS=4
MASTER_TYPE=e2-standard-2
WORKER_TYPE=e2-standard-2
NUM_WORKERS=2
# Optional executor layout for infra/submit.sh (empty = its e2-standard-2 default)
SPARK_PROPS=

# ---- Live stream (Phase 5 live mode / Phase 8) ----
ETH_RPC_URL=

# ---- Chain (Phase 6 local, Phase 9 Sepolia) ----
CHAIN=local
LOCAL_RPC_URL=http://chain:8545
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
